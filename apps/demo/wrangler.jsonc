{
  "name": "emoji-picker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": "./.cloudflare/output/v0/workers/default/assets", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "EMOJI_INDEX", "index_name": "emoji-bge-large" }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:*",
    "AI_GATEWAY_ID": "default"
  }
}
