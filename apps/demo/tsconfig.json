{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@brianhung/source"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "mdx"],
    "paths": { "@/registry/*": ["./registry/*"], "@/*": ["./src/*"] }
  },
  "include": ["src", "registry", "capture", "scripts", "plugins", "vite.config.ts"],
  "exclude": ["capture/out"]
}
