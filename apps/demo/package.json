{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:registry": "shadcn build registry.json --output public/r",
    "build": "npm run build:registry && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "embed": "tsx scripts/embed-emoji.ts",
    "create-index": "wrangler vectorize create emoji-bge-large --dimensions=1024 --metric=cosine",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --config worker/vitest.config.ts",
    "deploy": "wrangler deploy",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots",
    "test:behavior": "playwright test behavior",
    "test:behavior:update": "playwright test behavior --update-snapshots",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -c e2e/a11y/playwright.config.ts",
    "test:sr:voiceover": "playwright test -c e2e/sr/playwright.config.ts --project voiceover",
    "test:sr:nvda": "playwright test -c e2e/sr/playwright.config.ts --project nvda",
    "test:baseline": "E2E_BUILD=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@brianhung/emoji-picker": "*",
    "@huggingface/transformers": "^4.3.2",
    "@lexical/react": "^0.53.0",
    "@lisse/react": "^0.7.3",
    "@pierre/highlights": "^0.4.0",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lexical": "^0.53.0",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sf-symbols-lib": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.10",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@guidepup/setup": "^0.29.3",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "cf": "^1.0.0-beta.27",
    "playwright": "^1.56.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "cloudflare": {
    "label": "Emoji Picker",
    "products": [
      "Workers",
      "Workers AI",
      "Vectorize",
      "AI Gateway"
    ],
    "categories": [
      "ai"
    ],
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "Bearer token for POST /api/admin/seed, which fills the Vectorize index. Generate one with `node -e \"console.log(crypto.randomUUID())\"`."
      }
    }
  }
}
