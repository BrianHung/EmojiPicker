{
  "name": "search-worker",
  "description": "Semantic emoji search on Cloudflare: Workers AI embeddings + Vectorize, and TypeSafe's Jev through AI Gateway.",
  "private": true,
  "type": "module",
  "cloudflare": {
    "label": "Emoji semantic search",
    "products": [
      "Workers",
      "Workers AI",
      "Vectorize",
      "AI Gateway"
    ],
    "categories": [
      "ai"
    ],
    "bindings": {
      "TYPESAFE_API_KEY": {
        "description": "TypeSafe API key for Jev (POST /jev). Leave empty to serve only /embed-search."
      },
      "ADMIN_TOKEN": {
        "description": "Bearer token for POST /admin/seed. Generate with `node -e \"console.log(crypto.randomUUID())\"`."
      }
    }
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "predeploy": "wrangler vectorize create emoji-bge-large --dimensions=1024 --metric=cosine || true",
    "deploy": "wrangler deploy",
    "seed": "node scripts/seed.ts",
    "sync-emoji": "node scripts/sync-emoji.ts",
    "types": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.10",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^22.20.5",
    "cf": "^1.0.0-beta.27",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
