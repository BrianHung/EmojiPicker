{
  "name": "@brianhung/emoji-picker",
  "version": "3.0.0-alpha.0",
  "description": "Virtualized, unstyled React components for emoji pickers, tapbacks, and shortcode autocomplete.",
  "keywords": [
    "react",
    "emoji",
    "emoji-picker",
    "headless",
    "shortcodes",
    "slack",
    "tapback",
    "twemoji",
    "skin-tone",
    "autocomplete"
  ],
  "license": "MIT",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/EmojiPicker/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrianHung/EmojiPicker",
    "directory": "packages/emoji-picker"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "emoji-picker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "src/styles",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "@brianhung/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "@brianhung/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./search": {
      "@brianhung/source": "./src/search.ts",
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./floating-ui": {
      "@brianhung/source": "./src/floating-ui.ts",
      "types": "./dist/floating-ui.d.ts",
      "import": "./dist/floating-ui.js"
    },
    "./react-aria": {
      "@brianhung/source": "./src/react-aria.ts",
      "types": "./dist/react-aria.d.ts",
      "import": "./dist/react-aria.js"
    },
    "./data/en.json": "./data/en.json",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./shadcn.css": "./src/styles/shadcn.css"
  },
  "scripts": {
    "build:data": "tsx scripts/cli.ts build-data en --out data/en.json",
    "build": "npm run build:data && tsup",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "test:a11y": "node test/e2e/a11y.mjs",
    "e2e:serve": "vite --config test/e2e/vite.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "emojibase-data": ">=16.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "emojibase-data": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@react-types/shared": "^3.37.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "emojibase-data": "^18.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
