{
  "name": "@emoji-components/twemoji-font",
  "version": "1.0.0-alpha.2",
  "description": "Twemoji as a color emoji font: unicode-range web font subsets and a TrueType file.",
  "keywords": [
    "emoji",
    "twemoji",
    "font",
    "colr",
    "woff2",
    "ttf"
  ],
  "license": "CC-BY-4.0",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/emoji-components/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHung/emoji-components.git",
    "directory": "packages/twemoji-font"
  },
  "config": {
    "twemoji": "17.0.3"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/twemoji.css",
    "dist/*.woff2",
    "dist/Twemoji.ttf",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./twemoji.css": "./dist/twemoji.css",
    "./Twemoji.ttf": "./dist/Twemoji.ttf",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsx scripts/build.ts --check",
    "prepack": "npm run build",
    "test": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "emojibase-data": "18.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
