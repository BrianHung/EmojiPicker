{
  "name": "@brianhung/emoji-picker-twemoji-font",
  "version": "1.0.0-alpha.0",
  "description": "Twemoji as a color emoji web font, split into unicode-range subsets.",
  "keywords": [
    "emoji",
    "twemoji",
    "font",
    "colr",
    "woff2"
  ],
  "license": "CC-BY-4.0",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/EmojiPicker/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHung/EmojiPicker.git",
    "directory": "packages/twemoji-font"
  },
  "config": {
    "twemoji": "17.0.3"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/twemoji.css",
    "dist/*.woff2",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./twemoji.css": "./dist/twemoji.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "npm run build",
    "test": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "emojibase-data": "18.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
