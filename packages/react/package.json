{
  "name": "emoji-components",
  "version": "1.0.0-alpha.3",
  "description": "Unstyled, composable emoji picker for React.",
  "keywords": [
    "react",
    "emoji",
    "emoji-picker",
    "headless",
    "shortcodes",
    "tapback",
    "twemoji",
    "skin-tone",
    "autocomplete",
    "react-emoji-picker",
    "emoji-picker-react",
    "shadcn",
    "headless-ui"
  ],
  "license": "MIT",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/emoji-components/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHung/emoji-components.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "r",
    "src/styles",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "@emoji-components/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./picker": {
      "@emoji-components/source": "./src/picker/index.ts",
      "types": "./dist/picker/index.d.ts",
      "default": "./dist/picker/index.js"
    },
    "./emoji": {
      "@emoji-components/source": "./src/emoji/index.ts",
      "types": "./dist/emoji/index.d.ts",
      "default": "./dist/emoji/index.js"
    },
    "./provider": {
      "@emoji-components/source": "./src/provider/index.ts",
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./shadcn.css": "./src/styles/shadcn.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../apps/demo/scripts/build-registry.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:react18": "npm install --no-save --no-audit --no-fund --prefix ../../node_modules/.react18 react@18.3.1 react-dom@18.3.1 && vitest run -c vitest.react18.config.mts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@emoji-components/core": "1.0.0-alpha.3",
    "@react-types/shared": "^3.37.0",
    "dom-input-range": "^2.0.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
