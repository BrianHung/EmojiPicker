{
  "name": "@brianhung/emoji-picker-react",
  "version": "3.0.0-alpha.0",
  "description": "Virtualized, unstyled React components for emoji pickers, tapbacks, and shortcode autocomplete.",
  "keywords": [
    "react",
    "emoji",
    "emoji-picker",
    "headless",
    "shortcodes",
    "tapback",
    "twemoji",
    "skin-tone",
    "autocomplete"
  ],
  "license": "MIT",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/EmojiPicker/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHung/EmojiPicker.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "@brianhung/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./floating-ui": {
      "@brianhung/source": "./src/floating-ui.ts",
      "types": "./dist/floating-ui.d.ts",
      "import": "./dist/floating-ui.js"
    },
    "./react-aria": {
      "@brianhung/source": "./src/react-aria.ts",
      "types": "./dist/react-aria.d.ts",
      "import": "./dist/react-aria.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./shadcn.css": "./src/styles/shadcn.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@brianhung/emoji-picker-core": "^0.0.0",
    "@react-types/shared": "^3.37.0",
    "dom-input-range": "^2.0.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
