{
  "name": "@brianhung/emoji-picker-core",
  "version": "1.0.0-alpha.0",
  "description": "Framework-neutral emoji data, search, frequently used emoji, skin tones, picker and typeahead state.",
  "keywords": [
    "emoji",
    "emoji-picker",
    "headless",
    "shortcodes",
    "search",
    "skin-tone",
    "autocomplete"
  ],
  "license": "MIT",
  "author": "Brian Hung",
  "homepage": "https://emoji.brianhung.me",
  "bugs": "https://github.com/BrianHung/EmojiPicker/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHung/EmojiPicker.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "bin": {
    "emoji-picker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "@brianhung/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "@brianhung/source": "./src/search/index.ts",
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./data/en.json": {
      "types": "./data/en.json.d.cts",
      "default": "./data/en.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:data": "tsx scripts/cli.ts build-data en --out data/en.json",
    "build": "npm run build:data && tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "emojibase-data": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "emojibase-data": {
      "optional": true
    }
  },
  "devDependencies": {
    "@brianhung/emoji-picker-twemoji-font": "^1.0.0-alpha.0",
    "@types/node": "^22.20.5",
    "emojibase": "^18.0.0",
    "emojibase-data": "^18.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
